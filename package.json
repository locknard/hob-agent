{
  "name": "hob-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "check": "pnpm check:types && pnpm check:instructions",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:instructions": "sh scripts/sync-agent-instructions.sh --check",
    "prepare": "sh scripts/install-git-hooks.sh",
    "sync:agents": "sh scripts/sync-agent-instructions.sh",
    "test": "sh tests/agent-instructions.test.sh && NODE_NO_WARNINGS=1 tsx --test packages/*/src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
