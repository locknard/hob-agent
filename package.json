{
  "name": "hob-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "start": "tsx packages/hub/src/main.ts",
    "validate:home": "tsx packages/hub/src/home-validation.ts",
    "observe:home": "tsx packages/hub/src/home-observe-once.ts",
    "credentials:model": "tsx packages/hub/src/model-credential-setup.ts",
    "credentials:bridge": "tsx packages/hub/src/bridge-credential-setup.ts",
    "credentials:music-assistant": "tsx packages/hub/src/music-assistant-credential-setup.ts",
    "credentials:test": "tsx packages/hub/src/model-credential-probe.ts",
    "draft:home-map": "tsx packages/hub/src/home-map-draft.ts",
    "inbox:home": "tsx packages/hub/src/home-inbox.ts",
    "check": "pnpm check:types && pnpm check:instructions",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:instructions": "sh scripts/sync-agent-instructions.sh --check",
    "prepare": "sh scripts/install-git-hooks.sh",
    "sync:agents": "sh scripts/sync-agent-instructions.sh",
    "test": "sh tests/agent-instructions.test.sh && NODE_NO_WARNINGS=1 tsx --test contracts/*.test.ts packages/*/src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
